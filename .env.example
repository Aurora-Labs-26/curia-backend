# Anthropic — required (used for ingest, idea generation, outline, transcript)
ANTHROPIC_API_KEY=sk-ant-...

# Postgres — required
DATABASE_URL=postgresql://curia:curia@localhost:5432/curia

# Voyage AI — embedding provider. Optional: stub returns zero vectors if unset.
VOYAGE_API_KEY=

# TTS providers — set the key for whichever provider your speaker bindings use.
# Each provider falls back to a silent WAV stub when its key is missing.
ELEVENLABS_API_KEY=
# SMALLEST_API_KEY=                # Smallest.ai (Lightning TTS)
# GOOGLE_TTS_API_KEY=              # Google Cloud Text-to-Speech (API-key auth path)
# XAI_API_KEY=                     # xAI / Grok (TTS endpoint not yet public)

# Audio output — applies regardless of TTS provider
# CURIA_AUDIO_BITRATE=128k         # MP3 bitrate for the final episode (default 128k)
# CURIA_STITCH_GAP_MS=400          # silence between transcript lines (default 400 ms)

# Firecrawl — fallback scraper for JS-heavy/paywalled pages (optional)
# FIRECRAWL_API_KEY=

# YouTube — route transcript fetch through a local Tor SOCKS proxy (127.0.0.1:9050)
# to reduce IP-block risk. Requires `brew install tor && brew services start tor`.
# YOUTUBE_USE_TOR=false

# Curia environment — selects environment-scoped overrides in config/models.yaml
# (e.g. dev uses Haiku for transcript; prod uses Sonnet)
CURIA_ENV=dev

# Optional — override the LLM config path
# CURIA_LLM_CONFIG=/abs/path/to/models.yaml

# Deepgram Aura TTS — set if a speaker is bound to the deepgram provider
# DEEPGRAM_API_KEY=

# Sarvam AI Bulbul TTS — Indian languages/accents; set if a speaker is bound to sarvam
# SARVAM_API_KEY=

# Cartesia Sonic TTS — set if a speaker is bound to cartesia (voice_id = Cartesia voice UUID)
# CARTESIA_API_KEY=

# Jina Reader — optional scrape tier between trafilatura and firecrawl
# (r.jina.ai, free key = 500 req/min). Unset = tier skipped entirely.
# JINA_API_KEY=
# JINA_READER_URL=https://r.jina.ai

# BGM/SFX bank (per-segment vibe mix) — NOT committed to git (~473MB).
# Resolution: CURIA_BGM_DIR override → repo assets/ → S3 sync to local cache.
# CURIA_BGM_DIR=                          # explicit local bank dir (dev)
# CURIA_BGM_S3_BUCKET=curia-audio         # defaults to CURIA_S3_BUCKET, then curia-audio
# CURIA_BGM_CACHE_DIR=/tmp/curia_bgm_cache
# CURIA_SFX_PATH=                         # explicit transition-SFX file override

# PostHog — backend analytics (episode_generated, source_ingested, etc.). Optional:
# events no-op entirely when unset. distinct_id is firebase_uid, joining frontend events.
# POSTHOG_PROJECT_TOKEN=
# POSTHOG_HOST=https://us.i.posthog.com

# Anthropic API Key (Required for transcript generation)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# WeatherAPI.com key (free tier — https://www.weatherapi.com/signup.aspx)
WEATHERAPI_KEY=your-weatherapi-key-here

# Google Calendar (service account) — only used by legacy/calendar_service.py,
# which is archived and not wired into the live app. Share your calendar with
# the service account's client_email, then set its calendar ID (usually your
# Gmail address), if you ever revive that module.
GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
GOOGLE_CALENDAR_ID=your-email@gmail.com

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Optional shared HTTP Basic Auth in front of the whole app. Leave both blank
# to disable (default for local dev). Used to gate temporary public test
# deployments (e.g. a Railway test link shared with a handful of testers).
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Local Postgres for the harness's pre-opt/per-user-brief cache schema
# (`harness.*` tables). Matches docker-compose.yml's default local Postgres —
# run `docker compose up -d` then `python -m scripts.bootstrap_db`.
DATABASE_URL=postgresql://curia:curia_dev@localhost:5433/curia_harness
